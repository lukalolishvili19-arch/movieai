# Backend configuration. Copy to backend/.env for local development (loaded automatically) or set these
# as real environment variables in production (Render). Placeholders only — never commit real values.

# Production: set SPRING_PROFILES_ACTIVE=prod. It removes all localhost fallbacks, forces Secure cookies,
# disables Swagger UI and makes DATABASE_URL, TMDB_ACCESS_TOKEN, JWT_* and CORS_ALLOWED_ORIGINS required.
# SPRING_PROFILES_ACTIVE=prod

# TMDB API Read Access Token (v4 "Bearer" token) from https://www.themoviedb.org/settings/api
# Server-side only: never expose it to the browser or put it in a VITE_ variable.
TMDB_ACCESS_TOKEN=your-tmdb-read-access-token
TMDB_API_BASE_URL=https://api.themoviedb.org/3
TMDB_DEFAULT_REGION=US

# PostgreSQL. Accepts a JDBC URL or a postgres://user:pass@host:port/db URL (as provided by Render).
# Append ?sslmode=require when connecting to a provider's external/public hostname.
DATABASE_URL=jdbc:postgresql://localhost:5432/movieai
DATABASE_USERNAME=movieai
DATABASE_PASSWORD=change-me
# DATABASE_POOL_SIZE=10

# JWT signing secrets: at least 32 bytes each, different from each other.
# Generate with: openssl rand -base64 48   (prefix with "base64:" to use the decoded bytes)
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
# Token lifetimes (ISO-8601 or 15m / 30d style).
# JWT_EXPIRATION=15m
# JWT_REFRESH_EXPIRATION=30d

# Comma-separated browser origins allowed to call the API (the frontend URL). No trailing slash, no "*".
# Patterns are allowed for preview deployments, e.g. https://movieai-*-yourteam.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:8443,http://localhost:5173

# The refresh cookie is Secure by default (always Secure under the prod profile).
# SameSite: Lax when frontend and API share a site; None when they are on different sites
# (e.g. *.vercel.app + *.onrender.com). The prod profile defaults to None.
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAME_SITE=Lax

# Set to "native" when running behind a trusted reverse proxy that sets X-Forwarded-* headers
# (the prod profile defaults to native).
FORWARD_HEADERS_STRATEGY=none

# PORT is provided by the platform (defaults to 8080). Swagger UI / OpenAPI are on by default locally.
# PORT=8080
# API_DOCS_ENABLED=true
