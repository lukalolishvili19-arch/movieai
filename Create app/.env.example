# Frontend configuration (copy to .env.local). Only VITE_ variables reach the browser, so never put secrets here.

# Backend origin. Leave empty in development: the Vite dev server proxies /api to http://localhost:8080.
# In production set it to the API origin, e.g. https://api.example.com (and add the frontend origin to
# the backend's CORS_ALLOWED_ORIGINS).
VITE_API_URL=
