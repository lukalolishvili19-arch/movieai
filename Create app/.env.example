# Frontend configuration (copy to .env.local). Only VITE_ variables reach the browser, so never put secrets here.

# Backend origin, no trailing slash. Leave empty in development: the Vite dev server proxies /api to
# http://localhost:8080. In production (Vercel) set it to the API origin, e.g.
# VITE_API_URL=https://YOUR-RENDER-BACKEND.onrender.com
# and add the frontend origin to the backend's CORS_ALLOWED_ORIGINS.
VITE_API_URL=
